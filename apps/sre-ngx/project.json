{
  "name": "sre-ngx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sre-ngx/src",
  "prefix": "bubaxi",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/sre-ngx",
        "index": "apps/sre-ngx/src/index.html",
        "main": "apps/sre-ngx/src/main.ts",
        "polyfills": "apps/sre-ngx/src/polyfills.ts",
        "tsConfig": "apps/sre-ngx/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/sre-ngx/src/favicon.ico",
          "apps/sre-ngx/src/assets",
          "apps/sre-ngx/src/version"
        ],
        "styles": [
          "apps/sre-ngx/src/styles.scss",
          "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/sre-ngx/src/environments/environment.ts",
              "with": "apps/sre-ngx/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "sre-ngx:build:production"
        },
        "development": {
          "buildTarget": "sre-ngx:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 8030,
        "buildTarget": "sre-ngx:build:development"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "sre-ngx:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/sre-ngx"],
      "options": {
        "jestConfig": "apps/sre-ngx/jest.config.ts"
      }
    },
    "docker": {
      "executor": "./tools/executors/bubaxi:docker"
    },
    "deploy": {
      "executor": "./tools/executors/bubaxi:deploy"
    }
  }
}
